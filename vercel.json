{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "Vary", "value": "Accept, Accept-Encoding"}]},
    {"source": "/llms.txt", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]},
    {"source": "/sitemap.xml", "headers": [{"key": "Content-Type", "value": "application/xml; charset=utf-8"}]},
    {"source": "/content.md", "headers": [{"key": "Content-Type", "value": "text/markdown; charset=utf-8"}]}
  ]
}
